    {
      "id": "CH02_EP06_CHOICE",
      "type": "choice",
      "lifeContext": {
        "time": {
          "year": 2007,
          "month": 12,
          "season": "winter",
          "label": "2007 · 冬 · 晚饭",
          "location": "周叙家",
          "timeline": "memory"
        },
        "stage": "student",
        "relationships": {
