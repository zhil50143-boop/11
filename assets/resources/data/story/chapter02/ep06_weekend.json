      },
      "prompt": "要向家里说明最近和许知夏的来往吗？",
      "consequence": "父母是否知道两人的来往，会改变他们对这个周末的回应，也留下以后选校时要说清楚或继续瞒着的事。",
      "options": [
        {
          "id": "TELL",
          "text": "说起许知夏和一起洗照片的约定。",
          "next": "CH02_EP06_TOLD",
          "effects": {
            "honesty": 2
          },
          "setFlags": [
            "CH02_TOLD_FAMILY_RELATION"
          ]
        },
        {
          "id": "WAIT",
          "text": "先不提她，只说和陈野出去。",
          "next": "CH02_EP06_HIDDEN",
          "effects": {
            "avoidance": 1
          },
          "setFlags": [
            "CH02_HID_FAMILY_RELATION"
          ]
        }
      ]
