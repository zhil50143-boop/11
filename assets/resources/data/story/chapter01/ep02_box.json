          ],
          "next": "CH01_EP02_C001A"
        }
      ]
    },
    {
      "id": "CH01_EP02_A001",
      "type": "passage",
      "title": "先吃饭",
      "category": "main",
      "paragraphs": [
        {
          "speaker": "ANRAN",
          "text": "高中同学？还给你写过信。"
        },
        {
          "speaker": "ZHOUXU",
          "text": "挺久以前了。"
        },
        {
          "text": "她看了他一下，没再问，把桌角的电脑合上。周叙把信封压回照片下面，才发现自己的手一直捏着同一个角。"
        },
        {
          "speaker": "ANRAN",
          "text": "叫满满出来吧，菜好了。"
        }
      ],
      "next": "CH01_EP02_END",
      "lifeContext": {
        "time": {
          "year": 2037,
          "month": 9,
          "season": "autumn",
          "label": "2037 · 秋",
          "location": "家中",
          "timeline": "present"
        },
        "stage": "middleAge",
        "relationships": {
          "ANRAN": "有话没说完"
        }
      }
    },
    {
      "id": "CH01_EP02_B001",
      "type": "passage",
      "title": "先吃饭",
      "category": "main",
      "paragraphs": [
        {
          "speaker": "ANRAN",
          "text": "初恋？"
        },
        {
          "speaker": "ZHOUXU",
          "text": "嗯。那时候。"
        },
        {
          "text": "程安然点了下头。她想说什么，厨房的定时器先响了。她过去关掉，回来时把信封放在没沾水的地方。"
        },
        {
          "speaker": "ANRAN",
          "text": "那你自己收好。别和满满的练习册混了。"
        },
        {
          "text": "周叙说好，叫女儿出来吃饭。程安然顺手把那张湿报纸换了一张。"
        }
      ],
      "next": "CH01_EP02_END",
      "lifeContext": {
        "time": {
          "year": 2037,
          "month": 9,
          "season": "autumn",
          "label": "2037 · 秋",
          "location": "家中",
          "timeline": "present"
        },
        "stage": "middleAge",
        "relationships": {
          "ANRAN": "说起了过去"
        }
      }
    },
    {
      "id": "CH01_EP02_C001A",
      "type": "passage",
      "title": "先吃饭",
      "category": "main",
      "paragraphs": [
        {
          "speaker": "ANRAN",
          "text": "能把信留到现在，应该确实挺熟。"
        },
        {
          "text": "周叙没接话，把档案袋叠了两下。程安然去拿筷子，回来时他还在看那个名字。"
        },
        {
          "speaker": "ANRAN",
          "text": "放旁边吧，一会儿还得摆碗。"
        }
      ],
      "next": "CH01_EP02_END",
      "lifeContext": {
