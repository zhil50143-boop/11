      }
    },
    {
      "id": "CH01_EP04_N008",
      "type": "transition",
      "from": "2037年 · 家中",
      "to": "2007年9月7日 · 17路公交",
      "text": "雨落在公交车的玻璃上。",
      "next": "CH01_EP04_BUS",
      "setFlags": [
        "IN_MEMORY_2007"
      ],
      "lifeContext": {
        "time": {
          "year": 2037,
          "month": 9,
          "season": "autumn",
