{
  "episodeId": "CH01_EP01",
  "name": "雨夜回家",
  "startNode": "CH01_EP01_N001",
  "nodes": [
    {
      "id": "CH01_EP01_N001",
      "type": "narration",
      "text": "2037年9月7日，晚上19:42。",
      "next": "CH01_EP01_N002"
    },
    {
      "id": "CH01_EP01_N002",
      "type": "narration",
      "text": "雨比天气预报里说的来得更早。",
      "next": "CH01_EP01_N003"
    },
    {
      "id": "CH01_EP01_N003",
      "type": "narration",
      "text": "周叙推开门的时候，裤脚已经湿了一截。",
      "next": "CH01_EP01_N004"
    },
    {
      "id": "CH01_EP01_N004",
      "type": "dialogue",
      "speaker": "ANRAN",
      "expression": "neutral",
      "position": "center",
      "text": "鞋别往里面踩。",
      "next": "CH01_EP01_N005"
    },
    {
      "id": "CH01_EP01_N005",
      "type": "dialogue",
      "speaker": "ZHOUXU",
      "text": "嗯。",
      "next": "CH01_EP01_N006"
    },
    {
      "id": "CH01_EP01_N006",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "伞放阳台。",
      "next": "CH01_EP01_N007"
    },
    {
      "id": "CH01_EP01_N007",
      "type": "dialogue",
      "speaker": "ZHOUXU",
      "text": "知道。",
      "next": "CH01_EP01_N008"
    },
    {
      "id": "CH01_EP01_N008",
      "type": "narration",
      "text": "结婚十七年以后，很多对话已经短到不需要完整句子。",
      "next": "CH01_EP01_N009"
    },
    {
      "id": "CH01_EP01_N009",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "饭还差一会儿。",
      "next": "CH01_EP01_N010"
    },
    {
      "id": "CH01_EP01_N010",
      "type": "dialogue",
      "speaker": "ZHOUXU",
      "text": "满满呢？",
      "next": "CH01_EP01_N011"
    },
    {
      "id": "CH01_EP01_N011",
      "type": "dialogue",
      "speaker": "ZHOUMAN",
      "text": "我听见了！",
      "next": "CH01_EP01_N012"
    },
    {
      "id": "CH01_EP01_N012",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "听见也不知道出来打个招呼。",
      "next": "CH01_EP01_N013"
    },
    {
      "id": "CH01_EP01_N013",
      "type": "dialogue",
      "speaker": "ZHOUMAN",
      "text": "爸——我写作业呢！",
      "next": "CH01_EP01_N014"
    },
    {
      "id": "CH01_EP01_N014",
      "type": "dialogue",
      "speaker": "ANRAN",
      "expression": "slightSmile",
      "text": "她已经拿“写作业”当万能借口用了。",
      "next": "CH01_EP01_C001"
    },
    {
      "id": "CH01_EP01_C001",
      "type": "choice",
      "options": [
        {
          "id": "A",
          "text": "像我。",
          "effects": { "understandingPartner": 1 },
          "next": "CH01_EP01_A001"
        },
        {
          "id": "B",
          "text": "明明更像你。",
          "next": "CH01_EP01_B001"
        },
        {
          "id": "C",
          "text": "十六岁都这样。",
          "next": "CH01_EP01_C001A"
        }
      ]
    },
    {
      "id": "CH01_EP01_A001",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "你还挺有自知之明。",
      "next": "CH01_EP01_N015"
    },
    {
      "id": "CH01_EP01_B001",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "她拖延的时候才像你。",
      "next": "CH01_EP01_N015"
    },
    {
      "id": "CH01_EP01_C001A",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "你十六岁的时候什么样，我又没见过。估计也挺难伺候。",
      "next": "CH01_EP01_N015"
    },
    {
      "id": "CH01_EP01_N015",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "对了，有你的快递。",
      "next": "CH01_EP01_N016"
    },
    {
      "id": "CH01_EP01_N016",
      "type": "dialogue",
      "speaker": "ZHOUXU",
      "text": "我的？",
      "next": "CH01_EP01_N017"
    },
    {
      "id": "CH01_EP01_N017",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "高中寄来的。说是旧教学楼要拆，整理仓库翻出一批以前学生留下的东西。",
      "next": "CH01_EP01_N018"
    },
    {
      "id": "CH01_EP01_N018",
      "type": "narration",
      "text": "纸箱边角被雨水浸湿，寄件信息写着：南城第二中学旧校区资料整理组。",
      "next": "CH01_EP01_C002"
    },
    {
      "id": "CH01_EP01_C002",
      "type": "choice",
      "options": [
        {
          "id": "A",
          "text": "吃完饭再看。",
          "effects": { "reality": 1 },
          "next": "CH01_EP01_N019"
        },
        {
          "id": "B",
          "text": "现在看看。",
          "effects": { "nostalgia": 1 },
          "next": "CH01_EP01_N019"
        },
        {
          "id": "C",
          "text": "估计都是些旧东西。",
          "effects": { "avoidance": 1 },
          "next": "CH01_EP01_N019"
        }
      ]
    },
    {
      "id": "CH01_EP01_N019",
      "type": "dialogue",
      "speaker": "ANRAN",
      "text": "随你。",
      "next": "CH01_EP01_END"
    },
    {
      "id": "CH01_EP01_END",
      "type": "episodeEnd",
      "next": "CH01_EP02"
    }
  ]
}
