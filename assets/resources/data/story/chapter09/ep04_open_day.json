    {
      "id": "CH09_EP04_MEETING_CHOICE",
      "type": "choice",
      "prompt": "接受这次见面吗？",
      "consequence": "她给的是一次短的公开见面，之后各自还有安排。",
      "options": [
        {
          "id": "MEET",
          "text": "核清自己的时间，接受邀请。",
          "next": "CH09_EP04_ACCEPT",
          "setFlags": [
            "CH09_ACCEPTED_MEETING"
          ]
        },
        {
          "id": "DECLINE",
          "text": "说明这次不见，旧资料由学校留存。",
          "next": "CH09_EP04_DECLINE_REPLY",
          "effects": {
            "reality": 1
